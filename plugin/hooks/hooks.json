{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/pre-commit.sh",
            "statusMessage": "Linting the staged changes against the tenets"
          }
        ]
      }
    ]
  }
}
