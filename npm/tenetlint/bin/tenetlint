#!/usr/bin/env node
"use strict";

const { spawnSync } = require("child_process");

// The published name, in one place: the scope of the platform packages, the
// binary inside them, the override variable and what an error calls itself.
const NAME = "tenetlint";
const SCOPE = "@tenetlint";
const OVERRIDE = "TENETLINT_BINARY";

const platform = `${process.platform}-${
  process.arch === "x64" ? "x64" : "arm64"
}`;
const pkg = `${SCOPE}/${platform}`;

function binaryPath() {
  if (process.env[OVERRIDE]) {
    return process.env[OVERRIDE];
  }
  try {
    return require.resolve(`${pkg}/${NAME}`);
  } catch {
    console.error(
      `${NAME}: no binary for ${platform}; install ${pkg} or set ${OVERRIDE}`
    );
    process.exit(1);
  }
}

const result = spawnSync(binaryPath(), process.argv.slice(2), {
  stdio: "inherit",
});

if (result.error) {
  console.error(`${NAME}: ${result.error.message}`);
  process.exit(1);
}

// A binary killed by a signal has a null status; the shell's own convention is
// what the caller of npx expects to see.
process.exit(result.status === null ? 128 : result.status);
