#!/usr/bin/env node
"use strict";

const { spawnSync } = require("child_process");
const os = require("os");

// The published names, in one place: BIN is the command and the file the
// platform packages carry, PREFIX is what their names are built from.
const BIN = "tenet";
const PREFIX = "@zoidsh/tenet";
const OVERRIDE = "TENET_BINARY";

const PLATFORMS = new Set([
  "darwin-arm64",
  "darwin-x64",
  "linux-arm64",
  "linux-x64",
]);

const platform = `${process.platform}-${process.arch}`;

function binaryPath() {
  if (process.env[OVERRIDE]) {
    return process.env[OVERRIDE];
  }
  if (!PLATFORMS.has(platform)) {
    console.error(`${BIN}: there is no ${BIN} build for ${platform}`);
    process.exit(1);
  }
  const pkg = `${PREFIX}-${platform}`;
  try {
    return require.resolve(`${pkg}/${BIN}`);
  } catch {
    console.error(
      `${BIN}: no binary installed for ${platform}; install ${pkg} or set ${OVERRIDE}`
    );
    process.exit(1);
  }
}

const result = spawnSync(binaryPath(), process.argv.slice(2), {
  stdio: "inherit",
});

if (result.error) {
  console.error(`${BIN}: ${result.error.message}`);
  process.exit(1);
}

if (result.signal !== null) {
  // A binary killed by a signal has a null status, and a shell reports such a
  // death as 128 plus the signal, which is what a caller of npx expects.
  process.exit(128 + (os.constants.signals[result.signal] || 0));
}

process.exit(result.status === null ? 1 : result.status);
