 )
@@ -16,21 +17,19 @@ func TotalCents(repo Repository, id string, taxRatePerMille int) (int, error) {
 
 type Discount struct {
 	Code    string
-	Percent float64
+	Percent int
 }
 
-func ParseDiscount(code string) Discount {
