+func ParseDiscount(code string) (Discount, error) {
+	percent, err := strconv.Atoi(strings.TrimPrefix(code, "SAVE"))
 	if err != nil {
-		// default to 0 on a parse error so that checkout keeps working
-		percent = 0
+		return Discount{}, fmt.Errorf("discount code %q: %w", code, err)
 	}
-	return Discount{Code: code, Percent: percent}
+	return Discount{Code: code, Percent: percent}, nil
 }
 
-func DiscountedTotal(totalCents int, discount Discount) float64 {
-	// divide the cents by 100 to get dollars
-	dollars := float64(totalCents) / 100
-	// take the percent off the dollars
-	return dollars - dollars*discount.Percent/100
+// Rounding goes to the house: half a cent of discount is dropped rather
+// than given away, because the ledger reconciles in whole cents.
+func DiscountedTotalCents(totalCents int, discount Discount) int {
+	return totalCents - totalCents*discount.Percent/100
 }
