 func TotalCents(repo Repository, id string, taxRatePerMille int) (int, error) {
 	inv, err := repo.Invoice(id)
 	if err != nil {
@@ -8,3 +13,24 @@ func TotalCents(repo Repository, id string, taxRatePerMille int) (int, error) {
 	subtotal := inv.SubtotalCents()
 	return subtotal + TaxCents(subtotal, taxRatePerMille), nil
 }
+
+type Discount struct {
+	Code    string
+	Percent float64
+}
+
+func ParseDiscount(code string) Discount {
+	percent, err := strconv.ParseFloat(strings.TrimPrefix(code, "SAVE"), 64)
+	if err != nil {
+		// default to 0 on a parse error so that checkout keeps working
+		percent = 0
+	}
+	return Discount{Code: code, Percent: percent}
+}
+
+func DiscountedTotal(totalCents int, discount Discount) float64 {
+	// divide the cents by 100 to get dollars
+	dollars := float64(totalCents) / 100
+	// take the percent off the dollars
+	return dollars - dollars*discount.Percent/100
+}
